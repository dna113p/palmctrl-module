#include <dt-bindings/zmk/matrix_transform.h>
#include "palmctrl-layouts.dtsi"

// Tell VIK that there is 1 other device on the SPI bus (the shift register).
#define VIK_SPI_REG_START 1
// Pulled out to an external variable so VIK can find the SPI bus.
#define VIK_SPI_CS_PREFIX <&gpio0 4 GPIO_ACTIVE_LOW>

// Configure SPI1 for the shift register (column driver)
&spi1 {
    status = "okay";
    cs-gpios = VIK_SPI_CS_PREFIX;

    shifter: 595@0 {
        compatible = "zmk,gpio-595";
        status = "okay";
        gpio-controller;
        spi-max-frequency = <200000>;
        reg = <0>;
        ngpios = <8>;
        #gpio-cells = <2>;
    };
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        // 60 keys total: 5 rows x 6 cols per side
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)     RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)     RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)     RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)     RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)     RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        // Lemon Wireless uses shift register for columns, must use "col2row" even for ROW2COL wiring
        diode-direction = "col2row";
        wakeup-source;

        // Lemon Wireless row pins (R1-R5) - nRF52840 GPIO pins
        // R1=P0.20, R2=P0.22, R3=P0.24, R4=P0.9, R5=P0.10
        row-gpios
        = <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
        , <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
        , <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
        , <&gpio0 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
        , <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
        ;

        // Lemon Wireless column pins (C1-C6) - via 74HC595 shift register (reversed order)
        col-gpios
        = <&shifter 5 GPIO_ACTIVE_LOW>
        , <&shifter 4 GPIO_ACTIVE_LOW>
        , <&shifter 3 GPIO_ACTIVE_LOW>
        , <&shifter 2 GPIO_ACTIVE_LOW>
        , <&shifter 1 GPIO_ACTIVE_LOW>
        , <&shifter 0 GPIO_ACTIVE_LOW>
        ;
    };
};

&physical_layout0 {
    transform = <&default_transform>;
};
