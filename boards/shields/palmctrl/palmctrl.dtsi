#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>
#include "palmctrl-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
        zmk,underglow = &led_strip;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        // 60 keys total: 5 rows x 6 cols per side, now with filled bottom row
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)     RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)     RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)     RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)     RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)     RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        // Lemon Wireless uses shift register for columns, must use "col2row" even for ROW2COL wiring
        diode-direction = "col2row";
        wakeup-source;

        // Lemon Wireless row pins (R1-R5) with ROW2COL flags
        row-gpios
        = <&lemon 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
        , <&lemon 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
        , <&lemon 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
        , <&lemon 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
        , <&lemon 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
        ;

        // Lemon Wireless column pins (C1-C6) - shift register driven
        col-gpios
        = <&lemon 7 GPIO_ACTIVE_LOW>
        , <&lemon 8 GPIO_ACTIVE_LOW>
        , <&lemon 9 GPIO_ACTIVE_LOW>
        , <&lemon 10 GPIO_ACTIVE_LOW>
        , <&lemon 11 GPIO_ACTIVE_LOW>
        , <&lemon 12 GPIO_ACTIVE_LOW>
        ;
    };
};

// RGB LED strip for Pumpkin PCBs (WS2812B)
&pumpkins_spi {
    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <30>; // 30 LEDs per half (5 rows x 6 cols)
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

&physical_layout0 {
    transform = <&default_transform>;
};
