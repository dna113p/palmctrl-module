if SHIELD_PALMCTRL_LEFT

config ZMK_KEYBOARD_NAME
	default "PalmCtrl"

config ZMK_SPLIT_ROLE_CENTRAL
	default y

endif # SHIELD_PALMCTRL_LEFT

if SHIELD_PALMCTRL_LEFT || SHIELD_PALMCTRL_RIGHT

config ZMK_SPLIT
	default y

config SPI
	default y

config ZMK_RGB_UNDERGLOW
	default y
	select WS2812_STRIP
	select SPI

config ZMK_RGB_UNDERGLOW_BRT_START
	default 50

config ZMK_RGB_UNDERGLOW_EFF_START
	default 3

endif # SHIELD_PALMCTRL_LEFT || SHIELD_PALMCTRL_RIGHT
